# Copy privately to AUDIO_CONFIG_DIR/resolver.env; mode 0600.
# Match the Java plugin's resolver token, not Lavalink's separate password.
GENE_RESOLVER_TOKEN=
# Inside the node's private Docker namespace so Red's hook can reach port 2334.
# Compose publishes no host port. For a same-host Python process, use 127.0.0.1.
GENE_RESOLVER_BIND=0.0.0.0
GENE_RESOLVER_PORT=2334
GENE_AUDIO_CACHE=/media
GENE_AUDIO_CACHE_BYTES=268435456
GENE_AUDIO_CACHE_TTL=604800
GENE_AUDIO_RESERVE_BYTES=2147483648
# This Docker resolver delegates downloads to a trusted overlay relay.
# Use its private address and the relay's separate token. No public endpoint.
GENE_RELAY_URL=
GENE_RELAY_TOKEN=
