# Example values only. Keep configured values in ignored .env.local.
# Optional download relay: bind and peer must be your private overlay addresses.
GENE_RELAY_TOKEN=
GENE_RELAY_BIND=
GENE_RELAY_PEER=
GENE_RELAY_PORT=2335
# If Deno is not on PATH, set its executable's absolute path here.
GENE_DENO_PATH=
